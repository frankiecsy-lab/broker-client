# ====================================================================
# 1. 機密資料與環境變數（呼應 AGENTS.md 第 5 條規範：絕對禁止上傳）
# ====================================================================
.env
.env.local
.env.development
.env.production
*.env
*.secret

# ====================================================================
# 2. Python 虛擬環境（呼應 AGENTS.md 第 3 條規範：隔離不刪除）
# ====================================================================
venv/
.venv/
env/
ENV/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.eggs/

# ====================================================================
# 3. PyCharm / JetBrains IDE 自動產生的設定檔（防止視窗佈局干擾）
# ====================================================================
.idea/
*.iml
*.iws
.pytest_cache/

# ====================================================================
# 4. Python 編譯快取與執行垃圾（保持代碼乾淨）
# ====================================================================
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
installed.cfg

# ====================================================================
# 5. 測試環境臨時廢料（呼應 AGENTS.md 第 3 條規範：動態清理目標）
# ====================================================================
test_tmp.py
dummy_data.json
*.log
*.tmp

# ====================================================================
# 6. Node / 前端 build 產物（frontend/ 有自己嘅 .gitignore 處理 node_modules/dist）
# ====================================================================
backend/static/
backend/static_desktop/

# ====================================================================
# 7. AI 巨量上下文防禦（防止 Agent 讀取大型資料集、模型、快取或多媒體）
# ====================================================================
# --- 阻止讀取常見的 AI/LLM 快取與權重 ---
.llama/
.lmstudio/
.huggingface/
.cache/
models/
weights/
*.safetensors
*.bin
*.gguf

# --- 阻止讀取大型資料庫、向量庫、多媒體與大數據集 ---
*.db
*.sqlite3
*.csv
*.xlsx
*.pkl
*.jsonl
data/
datasets/
storage/
media/
uploads/

# ====================================================================
# 8. Node.js & 前端殘留防禦（防止後端 Agent 意外跨入前端目錄或掃描快取）
# ====================================================================
node_modules/
.npm/
.pnpm-store/
.yarn/
.next/
.nuxt/
out/

# ====================================================================
# 9. 系統級與編輯器隱藏快取（防止 Mac/Windows 系統垃圾與 VS Code 歷史干擾）
# ====================================================================
.DS_Store
Thumbs.db
.vscode/
.history/
*.bak

# ====================================================================
# 10. 當前專案特定大型動態目錄（請依據你實際的資料夾名稱取消註解 #）
# ====================================================================
# ifrs_db_v2/       <-- 如果有本地打包的資料庫資料夾，請放這邊
# frontend/         <-- 如果 Agent 不需要改前端，強烈建議直接排除整個前端目錄

# P8 symbol index cache（modules/symbol_search.py fetch 產生，~2MB，唔係 source code）
modules/symbol_index.json

