 <class>StrategiesPage</class>
 <widget class="QWidget" name="strategies_page">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>700</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="pageLayout">
   <property name="leftMargin"><number>10</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>10</number></property>
   <property name="bottomMargin"><number>8</number></property>
   <property name="spacing"><number>6</number></property>
   <!-- 頁級使用說明（文案屬 i18n → strategies_page.py _TEXT）：規則集語義 + 邊度會用到 -->
   <item>
    <widget class="QLabel" name="str_page_note">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
       <horstretch>0</horstretch><verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <!-- 表先（多選 → 刪除；單行 → 載入編輯）；欄寬／欄頭行為屬資料 → strategies_page.py -->
   <item>
    <widget class="QTableView" name="str_table">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
       <horstretch>0</horstretch><verstretch>0</verstretch>
      </sizepolicy>
     </property>
    </widget>
   </item>
   <!-- 基本欄：名稱 + 訊號BUFFER；買入價／數量屬固定欄（v1 read-only） -->
   <item>
    <layout class="QHBoxLayout" name="formRow">
     <property name="spacing"><number>4</number></property>
     <item>
      <widget class="QLabel" name="str_name_lbl">
       <property name="text"><string>名稱</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="str_name_edit">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
         <horstretch>0</horstretch><verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="placeholderText"><string>策略名稱</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="str_buffer_lbl">
       <property name="text"><string>訊號BUFFER(條)</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="str_buffer_spin"/>
     </item>
     <item>
      <widget class="QLabel" name="str_price_lbl">
       <property name="text"><string>買入價：市價</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="str_qty_lbl">
       <property name="text"><string>數量：最低一手</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <!-- 分數制係呢度最容易誤會嘅規則 → 先一句講清觸發條件（文案屬 i18n） -->
   <item>
    <widget class="QLabel" name="str_score_note">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <!-- 買／賣兩組條件編輯器（分數制）：combo／分數行屬排版；
        動態參數欄由 strategies_page.py 按 strategies.CONDITION_DEFS 填進 str_*_paramSlot，
        已加條件（draft）逐條填進 str_*_rulesSlot —— 數量屬資料，唔寫落呢度 -->
