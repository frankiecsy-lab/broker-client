<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FutuTradePage</class>
 <!--
   FUTU 交易頁排版（Qt Designer 可開）。身份契約：objectName == page 入面嘅 Python 屬性名
   （QUiLoader 會將子 widget 掛做 root attribute），改名要兩邊同步。
   `og` / `role` 呢類自訂 dynamic property Designer 帶唔住 → 一律由 futu_trade_page._STAMP 喺 load 後注入。
   欄位/卡片比例用 sizePolicy 嘅 horstretch/verstretch（= Designer「Layout Stretch」），
   因為 `.ui` 嘅 <item> 唔帶 stretch 屬性（uic: Unexpected attribute stretch）；root 級要
   剩餘高度歸某區，就包一個 wrapper widget 帶 verstretch（見 cols_wrap）。
   Designer 改呢檔時注意：QGridLayout 間距屬性名必須係 horizontalSpacing/verticalSpacing
   （寫 hspacing/vspacing 會被 uic 靜靜丟掉，實測變返 6）；card 嘅 vsizetype 唔好寫 Fixed。
   表格欄數、下拉 item、TIF/市場選項嘅「數量」全部屬資料 → 由 code 填，呢檔唔使改。
 -->
 <widget class="QWidget" name="futu_trade_page">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1280</width><height>860</height></rect>
  </property>
  <layout class="QVBoxLayout" name="pageLayout">
   <property name="leftMargin"><number>24</number></property>
   <property name="topMargin"><number>24</number></property>
   <property name="rightMargin"><number>24</number></property>
   <property name="bottomMargin"><number>24</number></property>
   <property name="spacing"><number>6</number></property>

   <!-- ── Header card（pagetitle / pagebody 靠 app-level [og="pagecard"] + [role=...] style）
        淨係 verstretch=0（唔食剩餘高度）；vsizetype 必須 Preferred，Fixed 會令
        QWidgetItem 把 item 最小高度抬到 sizeHint，成頁 minimumSizeHint 多 28px ── -->
   <item>
    <widget class="QWidget" name="header_card">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
       <horstretch>0</horstretch><verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <layout class="QVBoxLayout" name="headerLayout">
      <property name="leftMargin"><number>32</number></property>
      <property name="topMargin"><number>24</number></property>
      <property name="rightMargin"><number>32</number></property>
      <property name="bottomMargin"><number>24</number></property>
      <property name="spacing"><number>6</number></property>
      <item>
       <widget class="QLabel" name="title_lbl">
        <property name="text"><string>FUTU 交易</string></property>
       </widget>
      </item>
      <item>
       <spacer name="headerGap">
        <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
        <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
        <property name="sizeHint" stdset="0"><size><width>0</width><height>10</height></size></property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="body_lbl">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="text"><string>連線、帳戶、落單同持倉</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ── 兩欄主區：左 = 今日訂單 + 持倉資金（horstretch 3）/ 右 = 連線帳戶 + 下單（2）── -->
   <item>
    <widget class="QWidget" name="cols_wrap">
     <!-- verstretch 1：root 剩餘高度全歸兩欄主區（等同命令式 v.addLayout(cols, 1)） -->
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
       <horstretch>0</horstretch><verstretch>1</verstretch>
      </sizepolicy>
     </property>
     <layout class="QHBoxLayout" name="colsLayout">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <property name="spacing"><number>16</number></property>
      <item>
       <widget class="QWidget" name="left_col">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
          <horstretch>3</horstretch><verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <layout class="QVBoxLayout" name="leftCol">
         <property name="leftMargin"><number>0</number></property>
         <property name="topMargin"><number>0</number></property>
         <property name="rightMargin"><number>0</number></property>
         <property name="bottomMargin"><number>0</number></property>
         <property name="spacing"><number>16</number></property>

         <!-- 今日訂單 card（verstretch 3 = 佔左欄 3/5 高度）-->
         <item>
          <widget class="QWidget" name="orders_card">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
             <horstretch>0</horstretch><verstretch>3</verstretch>
            </sizepolicy>
           </property>
           <layout class="QVBoxLayout" name="ordersCardLayout">
            <property name="leftMargin"><number>32</number></property>
            <property name="topMargin"><number>24</number></property>
            <property name="rightMargin"><number>32</number></property>
            <property name="bottomMargin"><number>24</number></property>
            <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QLabel" name="orders_title_lbl">
              <property name="text"><string>今日訂單</string></property>
             </widget>
            </item>
            <item>
             <spacer name="ordersHeadGap">
              <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
              <property name="sizeHint" stdset="0"><size><width>0</width><height>12</height></size></property>
             </spacer>
            </item>
            <item>
             <layout class="QHBoxLayout" name="ordersBtnRow">
              <property name="leftMargin"><number>0</number></property>
              <property name="topMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <property name="bottomMargin"><number>0</number></property>
              <property name="spacing"><number>6</number></property>
              <item>
               <widget class="QPushButton" name="orders_refresh_btn">
                <property name="text"><string>刷新</string></property>
               </widget>
              </item>
              <item>
               <spacer name="ordersBtnGap1">
                <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
                <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
                <property name="sizeHint" stdset="0"><size><width>8</width><height>0</height></size></property>
               </spacer>
              </item>
              <item>
               <widget class="QPushButton" name="cancel_sel_btn">
                <property name="text"><string>撤選中</string></property>
               </widget>
              </item>
              <item>
               <spacer name="ordersBtnGap2">
                <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
                <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
                <property name="sizeHint" stdset="0"><size><width>8</width><height>0</height></size></property>
               </spacer>
              </item>
              <item>
               <widget class="QPushButton" name="cancel_all_btn">
                <property name="text"><string>全撤</string></property>
               </widget>
              </item>
              <item>
               <spacer name="ordersBtnStretch">
                <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
                <property name="sizeType"><enum>QSizePolicy::Policy::Expanding</enum></property>
                <property name="sizeHint" stdset="0"><size><width>0</width><height>0</height></size></property>
               </spacer>
              </item>
             </layout>
            </item>
            <item>
             <spacer name="ordersStatusGap">
              <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
              <property name="sizeHint" stdset="0"><size><width>0</width><height>8</height></size></property>
             </spacer>
            </item>
            <item>
             <widget class="QLabel" name="orders_status_lbl">
              <property name="wordWrap"><bool>true</bool></property>
              <property name="text"><string/></property>
             </widget>
            </item>
            <item>
             <spacer name="ordersTableGap">
              <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
              <property name="sizeHint" stdset="0"><size><width>0</width><height>8</height></size></property>
             </spacer>
            </item>
            <!-- 欄數 = ORDER_COLS（屬資料）→ _config_table 設；欄名 i18n → _apply_headers -->
            <item>
             <widget class="QTableWidget" name="orders_table"/>
            </item>
           </layout>
          </widget>
         </item>

         <!-- 持倉同帳戶資金 card（verstretch 2）-->
         <item>
          <widget class="QWidget" name="pos_card">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
             <horstretch>0</horstretch><verstretch>2</verstretch>
            </sizepolicy>
           </property>
           <layout class="QVBoxLayout" name="posCardLayout">
            <property name="leftMargin"><number>32</number></property>
            <property name="topMargin"><number>24</number></property>
            <property name="rightMargin"><number>32</number></property>
            <property name="bottomMargin"><number>24</number></property>
            <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QLabel" name="pos_title_lbl">
              <property name="text"><string>持倉同帳戶資金</string></property>
             </widget>
            </item>
            <item>
             <spacer name="posHeadGap">
              <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
              <property name="sizeHint" stdset="0"><size><width>0</width><height>12</height></size></property>
