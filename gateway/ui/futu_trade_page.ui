         <!-- 下單 card（買入/賣出兩鍵；方向由按鍵決定）-->
         <item>
          <widget class="QWidget" name="order_card">
           <layout class="QVBoxLayout" name="orderCardLayout">
            <property name="leftMargin"><number>32</number></property>
            <property name="topMargin"><number>24</number></property>
            <property name="rightMargin"><number>32</number></property>
            <property name="bottomMargin"><number>24</number></property>
            <property name="spacing"><number>6</number></property>
            <item>
             <widget class="QLabel" name="order_title_lbl">
              <property name="text"><string>下單</string></property>
             </widget>
            </item>
            <item>
             <spacer name="orderHeadGap">
              <property name="orientation"><enum>Qt::Orientation::Vertical</enum></property>
              <property name="sizeType"><enum>QSizePolicy::Policy::Fixed</enum></property>
              <property name="sizeHint" stdset="0"><size><width>0</width><height>12</height></size></property>
             </spacer>
            </item>
            <!-- 代碼欄 = code_edit + code_hint_lbl（hint 屬狀態 → code 更新）；
                 ORDER_TYPES / TIF_OPTIONS 屬資料 → code 填 combo item -->
            <item>
             <layout class="QGridLayout" name="orderGrid">
              <property name="leftMargin"><number>0</number></property>
              <property name="topMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <property name="bottomMargin"><number>0</number></property>
              <property name="horizontalSpacing"><number>10</number></property>
              <property name="verticalSpacing"><number>8</number></property>
              <item row="0" column="0">
               <widget class="QLabel" name="code_lbl">
                <property name="text"><string>代碼 (code)</string></property>
               </widget>
              </item>
              <item row="0" column="1" rowspan="1" colspan="3">
               <widget class="QWidget" name="code_cell">
                <layout class="QVBoxLayout" name="codeCellLayout">
                 <property name="leftMargin"><number>0</number></property>
                 <property name="topMargin"><number>0</number></property>
                 <property name="rightMargin"><number>0</number></property>
                 <property name="bottomMargin"><number>0</number></property>
                 <property name="spacing"><number>6</number></property>
                 <item>
                  <widget class="QLineEdit" name="code_edit"/>
                 </item>
                 <item>
                  <widget class="QLabel" name="code_hint_lbl">
                   <property name="text"><string/></property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QLabel" name="otype_lbl">
                <property name="text"><string>訂單類型</string></property>
               </widget>
              </item>
              <item row="1" column="1">
               <widget class="QComboBox" name="otype_combo"/>
              </item>
              <item row="1" column="2">
               <widget class="QLabel" name="price_lbl">
                <property name="text"><string>價格</string></property>
               </widget>
              </item>
              <item row="1" column="3">
               <widget class="QLineEdit" name="price_edit"/>
