/* Tomato Broker Server — dark theme (GitHub-inspired, tomato accent) */

#MainWindow {
    background-color: #1E1F22;
}

QWidget {
    color: #E6E6E6;
    font-size: 13px;
}

/* ---- Menu bar / menus ---- */
QMenuBar {
    background-color: #1E1F22;
    border-bottom: 1px solid #3A3D42;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background-color: #2E3136;
    border-radius: 4px;
}
QMenu {
    background-color: #26282C;
    border: 1px solid #3A3D42;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #F1553B;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: #3A3D42;
    margin: 4px 8px;
}

/* ---- Top navigation rail ---- */
#NavBar {
    background-color: #1E1F22;
    border-bottom: 1px solid #3A3D42;
}
.navButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    color: #9AA0A6;
    font-weight: 600;
}
.navButton:hover {
    color: #E6E6E6;
    background-color: #26282C;
}
.navButton:checked {
    color: #F1553B;
    border-bottom: 2px solid #F1553B;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #2E3136;
    border: 1px solid #3A3D42;
    border-radius: 6px;
    padding: 6px 14px;
    color: #E6E6E6;
}
QPushButton:hover { background-color: #3A3D42; }
QPushButton:pressed { background-color: #26282C; }
QPushButton:disabled {
    color: #9AA0A6;
    background-color: #26282C;
    border-color: #3A3D42;
}
.primaryButton {
    background-color: #F1553B;
    border: 1px solid #F1553B;
    color: #FFFFFF;
    font-weight: 600;
}
.primaryButton:hover { background-color: #FF6A4D; }
.primaryButton:pressed { background-color: #D6452C; }
.dangerButton {
    background-color: transparent;
    border: 1px solid #F85149;
    color: #F85149;
}
.dangerButton:hover {
    background-color: #F85149;
    color: #FFFFFF;
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: #1E1F22;
    border-top: 1px solid #3A3D42;
    color: #9AA0A6;
}

/* ---- Panels / labels ---- */
.cardPanel {
    background-color: #26282C;
    border: 1px solid #3A3D42;
    border-radius: 8px;
}
.mutedLabel { color: #9AA0A6; }
.sectionTitle { font-size: 15px; font-weight: 700; }
.monoText { font-family: "Consolas", "Cascadia Mono", monospace; }
.chevronButton {
    background: transparent;
    border: none;
    color: #9AA0A6;
    padding: 2px;
}
.chevronButton:hover { color: #E6E6E6; }

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #2E3136;
    border: 1px solid #3A3D42;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #F1553B;
}
QLineEdit:focus, QSpinBox:focus { border: 1px solid #F1553B; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #3A3D42;
    background-color: #2E3136;
}
QCheckBox::indicator:checked {
    background-color: #F1553B;
    border-color: #F1553B;
}

/* ---- Tables ---- */
QTableWidget, QTableView {
    background-color: #26282C;
    alternate-background-color: #2E3136;
    gridline-color: #3A3D42;
    border: 1px solid #3A3D42;
}
QTableWidget::item { padding: 3px 6px; }
QHeaderView::section {
    background-color: #2E3136;
    color: #9AA0A6;
    border: none;
    border-bottom: 1px solid #3A3D42;
    padding: 5px 8px;
    font-weight: 600;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #2E3136;
    border: 1px solid #3A3D42;
    border-radius: 6px;
    text-align: center;
    color: #E6E6E6;
}
QProgressBar::chunk {
    background-color: #F1553B;
    border-radius: 5px;
}

/* ---- Scroll areas / scrollbars ---- */
QScrollArea { border: none; }
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3A3D42;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #9AA0A6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
