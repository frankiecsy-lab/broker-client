/* Tomato Broker Server — light theme (GitHub-inspired, tomato accent) */

#MainWindow {
    background-color: #F7F8FA;
}

QWidget {
    color: #24292F;
    font-size: 13px;
}

/* ---- Menu bar / menus ---- */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #DDE1E6;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
}
QMenuBar::item:selected {
    background-color: #F0F2F5;
    border-radius: 4px;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #DDE1E6;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px 5px 10px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #D6452C;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: #DDE1E6;
    margin: 4px 8px;
}

/* ---- Top navigation rail ---- */
#NavBar {
    background-color: #F7F8FA;
    border-bottom: 1px solid #DDE1E6;
}
.navButton {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    color: #57606A;
    font-weight: 600;
}
.navButton:hover {
    color: #24292F;
    background-color: #F0F2F5;
}
.navButton:checked {
    color: #D6452C;
    border-bottom: 2px solid #D6452C;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #DDE1E6;
    border-radius: 6px;
    padding: 6px 14px;
    color: #24292F;
}
QPushButton:hover { background-color: #F0F2F5; }
QPushButton:pressed { background-color: #E8EAED; }
QPushButton:disabled {
    color: #57606A;
    background-color: #F7F8FA;
    border-color: #DDE1E6;
}
.primaryButton {
    background-color: #D6452C;
    border: 1px solid #D6452C;
    color: #FFFFFF;
    font-weight: 600;
}
.primaryButton:hover { background-color: #E05A3F; }
.primaryButton:pressed { background-color: #B83A24; }
.dangerButton {
    background-color: transparent;
    border: 1px solid #CF222E;
    color: #CF222E;
}
.dangerButton:hover {
    background-color: #CF222E;
    color: #FFFFFF;
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: #F7F8FA;
    border-top: 1px solid #DDE1E6;
    color: #57606A;
}

/* ---- Panels / labels ---- */
.cardPanel {
    background-color: #FFFFFF;
    border: 1px solid #DDE1E6;
    border-radius: 8px;
}
.mutedLabel { color: #57606A; }
.sectionTitle { font-size: 15px; font-weight: 700; }
.monoText { font-family: "Consolas", "Cascadia Mono", monospace; }
.chevronButton {
    background: transparent;
    border: none;
    color: #57606A;
    padding: 2px;
}
.chevronButton:hover { color: #24292F; }

/* ---- Inputs ---- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE1E6;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #D6452C;
}
QLineEdit:focus, QSpinBox:focus { border: 1px solid #D6452C; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #DDE1E6;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #D6452C;
    border-color: #D6452C;
}

/* ---- Tables ---- */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F7F8FA;
    gridline-color: #DDE1E6;
    border: 1px solid #DDE1E6;
}
QTableWidget::item { padding: 3px 6px; }
QHeaderView::section {
    background-color: #F7F8FA;
    color: #57606A;
    border: none;
    border-bottom: 1px solid #DDE1E6;
    padding: 5px 8px;
    font-weight: 600;
}

/* ---- Progress bar ---- */
QProgressBar {
    background-color: #F0F2F5;
    border: 1px solid #DDE1E6;
    border-radius: 6px;
    text-align: center;
    color: #24292F;
}
QProgressBar::chunk {
    background-color: #D6452C;
    border-radius: 5px;
}

/* ---- Scroll areas / scrollbars ---- */
QScrollArea { border: none; }
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #DDE1E6;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #57606A; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
